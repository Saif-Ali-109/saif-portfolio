# Required: Google Gemini API key
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
# Optional. Comma-separated fallback models tried if the primary is unavailable.
FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
# Optional. Defaults to gemini-embedding-001.
EMBEDDING_MODEL=gemini-embedding-001

# Knowledge base (default: ./knowledge relative to the ai/ package)
KNOWLEDGE_DIR=

# RAG parameters (optional)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3
MAX_HISTORY=8

# Server
HOST=0.0.0.0
PORT=8001

# Security — REQUIRED only if the API is reached by non-browser clients or
# exposed directly. NOTE: do NOT set this for the public Vercel chatbot —
# the browser widget does not send an Authorization header, so the chat
# would break. Set it only when you call the API from scripts/curl (e.g. a
# LAN/docker deployment where the frontend is behind a proxy).
API_TOKEN=
# Comma-separated allowlist of frontend origins (e.g. http://localhost:3000).
# Leave empty to deny browser access; NEVER set "*" (it pairs with
# credentials and opens the API to all sites).
CORS_ORIGINS=
# Max requests per client IP per minute (per server instance).
RATE_LIMIT_PER_MINUTE=20
# Trust X-Forwarded-For for client IPs. TRUE behind a trusted proxy
# (Vercel/nginx), FALSE when the API is directly exposed (else spoofable).
TRUST_PROXY_HEADERS=true
# Expose OpenAPI/Swagger docs (false in production).
DOCS_ENABLED=false

# AI parameters (optional)
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=250
